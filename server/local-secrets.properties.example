db.host=localhost
db.port=3306
db.name=fitlog
db.username=root
db.password=change-me
app.auth.token-secret=change-this-for-shared-dev
app.auth.token-validity-hours=168
web.origin=http://localhost:3000
app.oauth.kakao.client-id=your-kakao-rest-api-key
app.oauth.kakao.client-secret=your-kakao-client-secret
app.oauth.kakao.redirect-uri=http://localhost:3000/auth/kakao/callback
app.oauth.google.client-id=your-google-client-id
app.oauth.google.client-secret=your-google-client-secret
app.oauth.google.redirect-uri=http://localhost:3000/auth/google/callback
app.data-gov-food-nutrition.service-key=your-data-go-kr-service-key
app.data-gov-food-nutrition.import-http-enabled=false
app.data-gov-food-nutrition.import-secret=change-this-food-import-secret
app.data-gov-food-nutrition.page-size=100
app.data-gov-food-nutrition.pause-ms-between-requests=100
webpush.vapid.public-key=your-vapid-public-key
webpush.vapid.private-key=your-vapid-private-key
webpush.vapid.subject=mailto:admin@example.com
webpush.scheduler.enabled=true
webpush.scheduler.fixed-delay-ms=60000
